{
  "expo": {
    "name": "penelope-mobile",
    "slug": "penelope-mobile",
    "scheme": "penelope",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "speechRecognitionPermission": "Permitir que o Penelope use o reconhecimento de fala para que você possa ditar pesquisas."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir que o Penelope use sua localização para calcular a distância até os imóveis."
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
