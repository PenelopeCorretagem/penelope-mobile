{
  "name": "penelope-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "mock:api": "json-server --watch mocks/db.json --port 3001 --host 0.0.0.0",
    "dev:mock": "concurrently --kill-others-on-fail \"npm run mock:api\" \"npx expo start --clear\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~54.0.36",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-speech-recognition": "^57.0.0",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "concurrently": "^9.1.2",
    "json-server": "^0.17.4",
    "typescript": "~5.9.2"
  },
  "private": true
}
