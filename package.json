{
  "name": "penelope-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "mock:api": "json-server --watch mocks/db.json --port 3001 --host 0.0.0.0",
    "dev:mock": "concurrently --kill-others-on-fail \"npm run mock:api\" \"npx expo start\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "^57.0.0",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.18",
    "expo-speech-recognition": "^57.0.0",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "concurrently": "^9.1.2",
    "json-server": "^0.17.4",
    "typescript": "~5.9.2"
  },
  "private": true
}
