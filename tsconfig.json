{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/app/*"],
      "@auth/*": ["src/modules/auth/*"],
      "@constant/*": ["src/constants/*"],
      "@dtos/*": ["src/types/*"],
      "@home/*": ["src/modules/home/*"],
      "@properties/*": ["src/modules/properties/*"],
      "@dashboard/*": ["src/modules/dashboard/*"],
      "@service-penelopec/*": ["src/services/*"],
      "@profile/*": ["src/modules/profile/*"],
      "@settings/*": ["src/modules/profile/submodules/settings/*"],
      "@shared/*": ["src/shared/*"]
    }
  }
}
