{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/app/*"],
      "@auth/*": ["src/modules/auth/*"],
      "@constant/*": ["src/shared/constants/*"],
      "@dtos/*": ["src/types/*"],
      "@home/*": ["src/modules/home/*"],
      "@properties/*": ["src/modules/properties/*"],
      "@dashboard/*": ["src/modules/dashboard/*"],
      "@service-penelopec/*": ["src/services/*"],
      "@settings/*": ["src/modules/settings/*"],
      "@acount-settings/*": ["src/modules/settings/submodules/acount/*"],
      "@app-settings/*": ["src/modules/settings/submodules/app/*"],
      "@shared/*": ["src/shared/*"]
    }
  }
}
